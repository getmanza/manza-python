#!/usr/bin/env bash
# bin/release adapter: must pass before the version bump is committed.
# Mirrors .github/workflows/ci.yml (install, fetch cassettes, lint, typecheck, test).
set -euo pipefail
cd "$(dirname "$0")/.."

# A venv bakes its absolute path into activate and every script shebang, so one
# left behind by a moved checkout looks present but runs nothing: rebuild it.
.venv/bin/pip --version >/dev/null 2>&1 || { rm -rf .venv; python3 -m venv .venv; }
PY=.venv/bin/python

"$PY" -m pip install --quiet --upgrade pip
"$PY" -m pip install --quiet -e ".[dev]"
"$PY" scripts/fetch_cassettes.py   # the replay tests need the zazu-ruby cassette tarball, as in CI
"$PY" -m ruff check
"$PY" -m mypy
"$PY" -m pytest
