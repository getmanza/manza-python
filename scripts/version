#!/usr/bin/env bash
# bin/release adapter: print the current version, or write a new one into every
# tracked file that carries it (src/zazu_sdk/_version.py; pyproject.toml reads it
# via hatch). PEP 440 spells prereleases 1.0.0rc1 where semver says 1.0.0-rc.1:
# convert when writing and back when reading so the semver string round-trips.
set -euo pipefail
cd "$(dirname "$0")/.."

file="src/zazu_sdk/_version.py"

if [ $# -eq 0 ]; then
  pep=$(sed -nE 's/^__version__ = "([^"]+)"$/\1/p' "$file")
  echo "$pep" | sed -E 's/^([0-9]+\.[0-9]+\.[0-9]+)a([0-9]+)$/\1-alpha.\2/; s/^([0-9]+\.[0-9]+\.[0-9]+)b([0-9]+)$/\1-beta.\2/; s/^([0-9]+\.[0-9]+\.[0-9]+)rc([0-9]+)$/\1-rc.\2/'
  exit 0
fi

pep=$(echo "$1" | sed -E 's/-alpha\.([0-9]+)$/a\1/; s/-beta\.([0-9]+)$/b\1/; s/-rc\.([0-9]+)$/rc\1/')
sed -i.bak -E "s/^__version__ = \"[^\"]+\"$/__version__ = \"$pep\"/" "$file"
rm -f "$file.bak"
